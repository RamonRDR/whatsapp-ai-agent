# All demos run offline. Never commit real credentials.
DATABASE_URL=sqlite:///./whatsapp_agent.db
DEMO_ENABLED=true
APP_ENV=local
ADMIN_API_KEY=replace-with-a-long-random-local-admin-key
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
ENABLE_REAL_SEND=false
LLM_PROVIDER=deterministic
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=400
LLM_MAX_TOOL_CALLS=3
MESSAGE_RETENTION_DAYS=30
